{
  "name": "ayrank-mcp",
  "version": "0.1.0",
  "description": "MCP server for the free AY Rank SEO and GEO tools API",
  "mcpName": "io.github.ay-automate/ayrank-mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ayrank-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ay-automate/ayrank-mcp.git"
  },
  "homepage": "https://github.com/ay-automate/ayrank-mcp",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 dist/test/tools.test.js dist/test/transport.test.js",
    "test:live": "node --test dist/test/live.test.js",
    "validate:server-json": "node scripts/validate-server-json.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
